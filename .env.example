# Supabase (앱 로그인)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# Gemini API (1단계 초안)
GEMINI_API_KEY=your_gemini_api_key
GEMINI_DRAFT_MODEL=gemini-2.5-flash-lite

# OpenAI API (2단계 최종 다듬기)
OPENAI_API_KEY=your_openai_api_key
OPENAI_FINAL_MODEL=gpt-5.4

# Anthropic API (3단계 휴먼 마무리 — 키 없으면 2단계까지만 실행)
ANTHROPIC_API_KEY=your_anthropic_api_key
CLAUDE_HUMANIZE_MODEL=claude-sonnet-4-20250514
# false 로 두면 3단계 비활성 (키가 있어도 스킵)
PIPELINE_STAGE3_ENABLED=true

# 파이프라인 단가 (1M 토큰당 USD, 변경 시 Vercel에서만 수정)
GEMINI_INPUT_PRICE_PER_1M=0.10
GEMINI_OUTPUT_PRICE_PER_1M=0.40
OPENAI_INPUT_PRICE_PER_1M=2.50
OPENAI_OUTPUT_PRICE_PER_1M=15.00
CLAUDE_INPUT_PRICE_PER_1M=3.00
CLAUDE_OUTPUT_PRICE_PER_1M=15.00
PIPELINE_MIN_CHARS=1500
PIPELINE_MAX_CHARS=1800
