# Supabase (앱 로그인 — 기존 유지)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# ── AI API 키 ──────────────────────────────────────────
# 글·이미지 모델에 따라 하나 또는 둘 다 설정
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key
AGENT_API_KEY=

# ── 네이버 블로그 자동화 (CLI / agent.config.local.json) ─
NAVER_ID=your_naver_id
NAVER_PASSWORD=your_naver_password
NAVER_BLOG_ID=your_blog_id

# ── 에이전트 콘텐츠 기본값 (선택) ───────────────────────
AGENT_TOPIC=
AGENT_CTA_TEXT=
AGENT_CTA_BUTTON_TEXT=
AGENT_CTA_BUTTON_LINK=
AGENT_TEXT_MODEL=gemini-2.5-flash
AGENT_IMAGE_MODEL=imagen-4.0-generate-001
AGENT_TONE=friendly
AGENT_IMAGE_COUNT=7

# ── 에이전트 실행 경로 ─────────────────────────────────
AGENT_OUTPUT_DIR=./agent-output
NAVER_SESSION_DIR=./.naver-session
JBAI_API_URL=http://localhost:3000
AGENT_API_TOKEN=your_random_secret_token
