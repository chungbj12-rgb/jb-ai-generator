{
  "manifest_version": 3,
  "name": "JB스포츠 AI 블로그 생성기",
  "description": "키워드·주제·CTA로 네이버 블로그 글을 자동 생성합니다.",
  "version": "1.0.0",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "JB 블로그 생성",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://jbai-three.vercel.app/*",
    "https://*.supabase.co/*"
  ]
}
